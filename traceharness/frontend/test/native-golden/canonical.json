  {
   "name": "key order",
   "args": [
    {
     "b": 1,
     "a": 2,
     "c": {
      "z": 0,
      "y": [
       3,
       2,
       1
      ]
     }
    }
   ],
   "expected": "{\"a\":2,\"b\":1,\"c\":{\"y\":[3,2,1],\"z\":0}}"
  },
  {
   "name": "non-ASCII keys sort by code point",
   "args": [
    {
     "\u00e9": 1,
     "z": 2,
     "\ud83d\ude42": 3,
     "\uff21": 4,
     "A": 5
    }
   ],
   "expected": "{\"A\":5,\"z\":2,\"\u00e9\":1,\"\uff21\":4,\"\ud83d\ude42\":3}"
  },
  {
   "name": "U+2028 and U+2029 kept as is",
   "args": [
    {
     "text": "a\u2028b\u2029c"
    }
   ],
   "expected": "{\"text\":\"a\u2028b\u2029c\"}"
  },
  {
   "name": "control characters escaped",
   "args": [
    {
     "text": "\u0000\u0001\b\t\n\u000b\f\r\u001f\u007f"
    }
   ],
   "expected": "{\"text\":\"\\u0000\\u0001\\b\\t\\n\\u000b\\f\\r\\u001f\u007f\"}"
  },
  {
   "name": "quotes and backslashes",
   "args": [
    {
     "text": "say \"hi\" \\ there"
    }
   ],
   "expected": "{\"text\":\"say \\\"hi\\\" \\\\ there\"}"
  },
  {
   "name": "astral characters kept",
   "args": [
    [
