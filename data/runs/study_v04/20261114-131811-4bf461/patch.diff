+    def cleanup(self):
+        for fname in os.listdir(self.root):
+            if not fname.endswith(".json"):
+                continue
+            p = os.path.join(self.root, fname)
+            try:
+                with open(p) as f:
+                    rec = json.load(f)
+                if self._now() - rec['t'] > self.ttl:
+                    os.remove(p)
+            except (IOError, json.JSONDecodeError):
+                # If file is corrupt or unreadable, remove it.
+                try:
+                    os.remove(p)
+                except OSError:
+                    pass # Ignore errors during removal
