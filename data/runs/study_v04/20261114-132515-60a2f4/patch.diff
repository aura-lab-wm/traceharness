--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,46 @@
 def split_row(line: str):
-    """Split one CSV line into fields. Fields may be double-quoted; inside a
-    quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    """Split one CSV row without using :mod:`csv`.
+
+    Commas inside double-quoted fields are part of the field, and two
+    consecutive double quotes inside such a field represent one literal
+    double quote.
+    """
+    fields = []
+    field = []
+    in_quotes = False
+    quote_closed = False
+    index = 0
+
+    while index < len(line):
+        char = line[index]
+
+        if in_quotes:
+            if char == '"':
+                # A doubled quote is escaped, rather than the end of the
+                # quoted field.
+                if index + 1 < len(line) and line[index + 1] == '"':
+                    field.append('"')
+                    index += 2
+                    continue
+                in_quotes = False
+                quote_closed = True
+            else:
+                field.append(char)
+        elif char == ',':
+            fields.append(''.join(field))
+            field = []
+            quote_closed = False
+        elif char == '"' and not field:
+            in_quotes = True
+            quote_closed = False
+        else:
+            # Characters after a closing quote are retained.  This keeps the
+            # parser permissive for malformed rows while still splitting on
+            # commas only when they are outside quotes.
+            field.append(char)
+            quote_closed = False
+
+        index += 1
+
+    fields.append(''.join(field))
+    return fields
