--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,30 @@
 def split_row(line: str):
-    """Split one CSV line into fields. Fields may be double-quoted; inside a
-    quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    """Split a CSV row, handling quoted fields and escaped quotes."""
+    fields = []
+    field = []
+    in_quotes = False
+    i = 0
+
+    while i < len(line):
+        char = line[i]
+        if in_quotes:
+            if char == '"':
+                # Two quotes inside a quoted field represent one quote.
+                if i + 1 < len(line) and line[i + 1] == '"':
+                    field.append('"')
+                    i += 1
+                else:
+                    in_quotes = False
+            else:
+                field.append(char)
+        elif char == ',' :
+            fields.append(''.join(field))
+            field = []
+        elif char == '"' and not field:
+            in_quotes = True
+        else:
+            field.append(char)
+        i += 1
+
+    fields.append(''.join(field))
+    return fields
