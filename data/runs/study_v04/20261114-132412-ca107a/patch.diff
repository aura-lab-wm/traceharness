--- a/tinycsv/rows.py
+++ b/tinycsv/rows.py
@@ -1,4 +1,40 @@
 def split_row(line: str):
-    """Split one CSV line into fields. Fields may be double-quoted; inside a
-    quoted field a comma is literal and a doubled quote is a literal quote."""
-    return [f.strip('"') for f in line.split(",")]
+    """Split one CSV line into fields.
+
+    Commas inside double-quoted fields are literal, and two consecutive
+    double quotes inside such a field represent one literal double quote.
+    """
+    fields = []
+    field = []
+    in_quotes = False
+    field_start = True
+    index = 0
+
+    while index < len(line):
+        char = line[index]
+
+        if char == '"':
+            if in_quotes:
+                if index + 1 < len(line) and line[index + 1] == '"':
+                    field.append('"')
+                    index += 2
+                    continue
+                in_quotes = False
+            elif field_start:
+                in_quotes = True
+            else:
+                field.append(char)
+        elif char == ',' and not in_quotes:
+            fields.append(''.join(field))
+            field = []
+            field_start = True
+            index += 1
+            continue
+        else:
+            field.append(char)
+
+        field_start = False
+        index += 1
+
+    fields.append(''.join(field))
+    return fields
