--- a/cfg/loader.py
+++ b/cfg/loader.py
@@ -2,4 +2,37 @@
     """Return a copy of `defaults` where any env var APP_<KEY> overrides the
     value for key <key> (lowercased), coerced to the type of the default."""
     cfg = dict(defaults)
+    for key, value in env.items():
+        if not key.startswith("APP_"):
+            continue
+        target = key[len("APP_"):].lower()
+        if target not in cfg:
+            continue
+        cfg[target] = _coerce(cfg[target], value)
     return cfg
+
+
+def _coerce(default, value):
+    """Coerce `value` (typically a string from the environment) to the type of
+    `default` (bool, int, float, or str)."""
+    # bool must be checked before int, since bool is a subclass of int.
+    if isinstance(default, bool):
+        return _coerce_bool(value)
+    if isinstance(default, int):
+        return int(value)
+    if isinstance(default, float):
+        return float(value)
+    if isinstance(default, str):
+        return str(value)
+    return value
+
+
+def _coerce_bool(value):
+    if isinstance(value, bool):
+        return value
+    text = str(value).strip().lower()
+    if text in ("true", "1", "yes", "y", "on"):
+        return True
+    if text in ("false", "0", "no", "n", "off", ""):
+        return False
+    raise ValueError(f"cannot coerce {value!r} to bool")
