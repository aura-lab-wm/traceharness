+    def cleanup(self):
+        for key in os.listdir(self.root):
+            p = os.path.join(self.root, key)
+            if not os.path.isfile(p):
+                continue
+            try:
+                with open(p) as f:
+                    rec = json.load(f)
+                if self._now() - rec['t'] > self.ttl:
+                    os.remove(p)
+            except (IOError, json.JSONDecodeError):
